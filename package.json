{
  "name": "epub-reader",
  "private": true,
  "version": "3.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/write-sample.mjs && tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "sample": "node scripts/write-sample.mjs",
    "test:watch": "vitest",
    "lint": "tsc -b --noEmit",
    "cap:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/screen-brightness": "^7.0.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/keyboard": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/literata": "^5.2.8",
    "@fontsource/newsreader": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.8",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  }
